# /etc/default/stratumtap --- environment for the stratumtap systemd unit.
#
# Every setting is optional; the values shown are the built-in defaults.
# Uncomment and change what you need, then:  systemctl restart stratumtap
#
# This file is sourced by systemd (EnvironmentFile=), so use plain KEY=value
# lines --- no `export`, no shell expansion, no inline comments after a value.

# --- Web server ----------------------------------------------------------
# Bind address. 0.0.0.0 listens on every interface; 127.0.0.1 for localhost
# only (e.g. when a reverse proxy sits in front).
#STRATUMTAP_HOST=0.0.0.0

# TCP port. For a port below 1024 you must also uncomment the
# CapabilityBoundingSet / AmbientCapabilities lines in the systemd unit.
#STRATUMTAP_PORT=8080

# --- gpsd ----------------------------------------------------------------
#STRATUMTAP_GPSD_HOST=127.0.0.1
#STRATUMTAP_GPSD_PORT=2947

# --- chrony --------------------------------------------------------------
# The chronyc executable (absolute path also works).
#STRATUMTAP_CHRONYC_BIN=chronyc

# How often `chronyc tracking` is polled, in seconds.
#STRATUMTAP_CHRONY_POLL_S=1.0

# How often `chronyc sources` / `sourcestats` are polled, in seconds.
#STRATUMTAP_SOURCES_POLL_S=10.0

# --- Server-side history -------------------------------------------------
# Sampling interval and ring-buffer size. The defaults keep 24 hours
# (17280 x 5 s) in memory --- roughly a few MB. Raising either raises RAM use.
#STRATUMTAP_HISTORY_INTERVAL_S=5.0
#STRATUMTAP_HISTORY_SIZE=17280

# --- UI defaults ---------------------------------------------------------
# Default browser auto-refresh interval, and the choices offered in the
# refresh dropdown (comma separated, seconds).
#STRATUMTAP_DEFAULT_REFRESH_S=2
#STRATUMTAP_REFRESH_CHOICES_S=1,2,5,10,30,60

# --- Map tiles -----------------------------------------------------------
# Point these at a local tile server for a fully offline install. The map
# degrades to a plain position readout when tiles cannot be fetched.
#STRATUMTAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
#STRATUMTAP_TILE_ATTRIBUTION=© OpenStreetMap contributors

# --- Demo mode -----------------------------------------------------------
# Serve plausible synthetic data instead of talking to gpsd/chrony. Useful to
# check the install before the GPS receiver is wired up.
#STRATUMTAP_DEMO=false
#STRATUMTAP_DEMO_LAT=51.4779
#STRATUMTAP_DEMO_LON=-0.0015

# --- MQTT / Home Assistant -----------------------------------------------
# Set the broker URL and StratumTap publishes one retained Home Assistant
# discovery message (a device with ~20 entities), a JSON state document and a
# last-will availability topic. Leave it empty and nothing MQTT-related runs.
#
#   mqtt://broker.lan
#   mqtt://stratumtap:secret@broker.lan:1883
#   mqtts://broker.lan:8883
#
# Percent-encode any @ / : in the password (@ is %40, : is %3A).
#STRATUMTAP_MQTT_URL=

# Topic roots. State goes to <prefix>/<device_id>/state.
#STRATUMTAP_MQTT_TOPIC_PREFIX=stratumtap
#STRATUMTAP_MQTT_DISCOVERY_PREFIX=homeassistant

# Identity. Both default to something derived from /etc/machine-id, which is
# stable across reboots and unique per machine --- set them only if you run two
# instances that must not collide, or you want readable topics.
#STRATUMTAP_MQTT_DEVICE_ID=
#STRATUMTAP_MQTT_CLIENT_ID=

# Throttling: publish at least every INTERVAL_S, never more often than
# MIN_INTERVAL_S, and in between only when something moved by more than a
# deadband (or a flag such as stratum/sync/fix changed).
#STRATUMTAP_MQTT_INTERVAL_S=60.0
#STRATUMTAP_MQTT_MIN_INTERVAL_S=5.0
#STRATUMTAP_MQTT_DEADBAND_OFFSET_US=50.0
#STRATUMTAP_MQTT_DEADBAND_PPM=0.5

# How long Home Assistant keeps showing a value before calling the entity
# unavailable. Keep it well above INTERVAL_S.
#STRATUMTAP_MQTT_EXPIRE_AFTER_S=180

# Retain the state message so a restarting Home Assistant has values at once.
#STRATUMTAP_MQTT_RETAIN_STATE=true

# mqtts:// only --- skip certificate/hostname checks (self-signed brokers).
#STRATUMTAP_MQTT_TLS_INSECURE=false

# QoS for state/position/availability. Discovery is always QoS 1 + retained.
#STRATUMTAP_MQTT_QOS=0

# --- Misc ----------------------------------------------------------------
# Comma-separated origins allowed to call /api/v1/* from a browser on another
# host. Empty (the default) disables CORS entirely.
#STRATUMTAP_CORS_ORIGINS=

# critical | error | warning | info | debug | trace
#STRATUMTAP_LOG_LEVEL=info
